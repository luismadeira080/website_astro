/* The shared 600px measure breaks this one-liner onto a second line; it is a
   single intro sentence, not a paragraph, so let it use the full width. */
.sectors-section .section-header p {
    max-width: none;
}

/* Four cards left, the remaining three as a full-height pillar right, so the
   catalog reads as seven areas rather than four plus an afterthought. */








/* Testimonials — paper-2, which also lifts the white quote cards off the
   background instead of leaving them to float on near-identical paper. */
.testimonials-section {
    padding: 120px var(--pad-x);
    background-color: var(--color-surface);
}

.testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 64px;
}

.testimonial-card {
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-shadow: var(--shadow-card);
}

/* Fixed-height slot, not a fixed width: logos come in different aspect
   ratios, and matching their heights is what makes them read as the same
   size. New clients need only the file and one <img>. */
.testimonial-logo {
    display: flex;
    align-items: center;
    height: 30px;
}

.testimonial-logo--lg {
    height: 46px;
}

.testimonial-logo img {
    height: 100%;
    width: auto;
    max-width: 190px;
    object-fit: contain;
    object-position: left center;
}

.testimonial-quote {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-soft);
    flex: 1;
    font-style: italic;
}

.testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
}

.testimonial-author strong {
    font-size: 14px;
