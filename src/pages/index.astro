    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WHTQCRZ4');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- SEO Meta Tags -->
    <SEO
        title="Reliable AI Processes for SMEs"
        description="Ongoing AI partner for SMEs. I map your business for highest-ROI opportunities and build reliable, deterministic processes that deliver consistent, auditable results."
        locale="en"
    />

    <!-- Structured Data -->
    <Schema type="Organization" />
    <Schema type="LocalBusiness" />
</head>
<body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WHTQCRZ4"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Navigation -->
    <nav class="navigation">
        <a href="/" class="logo">luís madeira</a>
        <div class="nav-links">
            <a href="/services">Services</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
            <LanguageSwitcher currentPath="/" />
        </div>
        <div class="mobile-menu-toggle">
            <span></span>
            <span></span>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <div class="hero-text">
                <h1>ENABLING <span class="hero-mark"><span>GROWTH</span></span> THROUGH AI-POWERED SOLUTIONS.</h1>
                <p class="hero-subtitle">I build AI-powered internal solutions, tailored to how your business actually works.</p>
            </div>
            <div class="hero-actions">
                <a href="/ai-contact" class="btn-primary">Let's talk</a>
            </div>
        </div>
        <div class="hero-image">
            <img src="/profile.jpeg" alt="Luís Madeira">
        </div>
    </section>

    <!-- My Process -->
    <section class="our-process-section">
        <div class="process-header reveal">
            <h2>MY PROCESS</h2>
            <p>A methodical, low-risk approach.</p>
        </div>

        <ol class="process-rail">
            <li class="rail-step">
                <div class="rail-track" aria-hidden="true"><span class="rail-node"></span></div>
                <div class="rail-body">
                    <div class="rail-heading">
                        <span class="rail-index">01</span>
                        <h3>Operations Audit</h3>
                    </div>
                    <div class="rail-detail">
                        <p class="rail-copy">I build a deep understanding of the business context, the systems in use, and the objectives. The assessment identifies high-impact opportunities before they become roadblocks.</p>
                        <span class="rail-outputs-label">Outputs</span>
                        <ul class="rail-outputs">
                            <li>Heatmap of Inefficiency</li>
                            <li>Value vs. Effort Matrix</li>
                            <li>ROI Prioritization Matrix</li>
                        </ul>
                    </div>
                </div>
            </li>

            <li class="rail-step">
                <div class="rail-track" aria-hidden="true"><span class="rail-node"></span></div>
                <div class="rail-body">
                    <div class="rail-heading">
                        <span class="rail-index">02</span>
                        <h3>Implementation</h3>
                    </div>
                    <div class="rail-detail">
                        <p class="rail-copy">I design the architecture and the roadmap, then build production-grade solutions that integrate with the systems already in use. Low-risk POCs prove the return early, and the work runs in short cycles with continuous feedback.</p>
                        <span class="rail-outputs-label">Outputs</span>
                        <ul class="rail-outputs">
                            <li>Solution architecture</li>
                            <li>Low-risk POC</li>
                            <li>Integrated production system</li>
                        </ul>
                    </div>
                </div>
            </li>

            <li class="rail-step">
                <div class="rail-track" aria-hidden="true"><span class="rail-node"></span></div>
                <div class="rail-body">
                    <div class="rail-heading">
                        <span class="rail-index">03</span>
                        <h3>Ongoing Support</h3>
                    </div>
                    <div class="rail-detail">
                        <p class="rail-copy">I monitor performance, optimize for efficiency, and help you scale what works across the organization.</p>
                        <span class="rail-outputs-label">Outputs</span>
                        <ul class="rail-outputs">
                            <li>Performance monitoring</li>
                            <li>New capability layers</li>
                            <li>Structured hand-off</li>
                        </ul>
                    </div>
                </div>
            </li>
        </ol>

    </section>

    <!-- Business Areas Section -->
    <section class="sectors-section">
        <div class="section-header reveal">
            <h2>Services</h2>
            <p>AI-powered internal solutions, applied across every area of your business.</p>
        </div>

        <!-- Scope list on the left drives one shared panel on the right. The
             panels carry their own title and sit in normal flow until the
             script adds .is-enhanced, so with no JS (and on mobile) this
             degrades to a plain stacked list with every service readable. -->
        <div class="svc reveal" data-svc>
            <div class="svc-scopes" role="tablist" aria-label="Services" aria-orientation="vertical">
                <button type="button" class="svc-scope is-active" role="tab" id="svc-tab-1" aria-controls="svc-panel-1" aria-selected="true">
