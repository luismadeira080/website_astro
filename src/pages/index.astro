/* Sectors Section */
.sectors-section {
    padding: 120px var(--pad-x);
    background-color: var(--color-bg);
}

/* Services — scope list and panel inside ONE frame.
   Everything is closed: the frame borders all four sides, the scope rows
   divide its height evenly, and the panel fills the rest. Nothing floats,
   and the structure is identical whichever scope is selected.

   Base state (no JS, and mobile) stacks every panel inside the same frame,
   titled and readable, so the content survives without scripting.
   .is-enhanced splits the frame into list + panel. */
.svc {
    background-color: var(--card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.svc-scopes {
    display: none;
}

.svc-panel {
    padding: 32px 28px;
    border-bottom: 1px solid var(--border-strong);
}

.svc-panel:last-child {
    border-bottom: 0;
}

/* Icon, then copy, then the capability list: the same order the panel
   keeps on mobile, where the title is visible between icon and copy.
   Matched to the service's icon on /services so a service reads as the
   same thing on both pages. */
.svc-panel-icon {
    display: flex;
    align-self: flex-start;
    color: var(--accent-deep);
    margin-bottom: 28px;
}

.svc-panel-title {
    font-family: var(--font-heading);
    font-size: 32px;
    letter-spacing: -0.32px;
    line-height: 1.05;
    color: var(--color-text);
    margin-bottom: 18px;
}

.svc-panel-copy {
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
    max-width: 54ch;
    margin: 0 0 34px;
}

/* A vertical list, not a wrapping row: the block keeps the same shape for
   every scope, which is what makes the panel feel stable while cycling. */
.svc-caps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.svc-caps li {
    font-size: 15.5px;
    font-weight: 500;
    color: var(--ink);
    padding-left: 16px;
    position: relative;
}

.svc-caps li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    background-color: var(--accent);
}






/* ---- enhanced: scopes on the left, one panel on the right ---- */
@media (min-width: 861px) {
    .svc.is-enhanced {
        display: grid;
        grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
        background-color: transparent;
    }

    .svc.is-enhanced .svc-scopes {
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--border-strong);
    }

    /* flex: 1 makes the four rows split the frame height evenly, so the list
       and the panel always end on the same line. */
    .svc.is-enhanced .svc-scope {
        flex: 1;
        position: relative;
        display: flex;
        align-items: center;
        gap: 16px;
        appearance: none;
        background: none;
        border: 0;
        border-bottom: 1px solid var(--border-strong);
        font-family: var(--font-heading);
        font-size: 26px;
        letter-spacing: -0.26px;
        line-height: 1.1;
        text-align: left;
        color: var(--muted);
        padding: 22px 32px 22px 28px;
        cursor: pointer;
        transition:
            color 0.3s var(--ease-smooth),
            background-color 0.3s var(--ease-smooth);
    }

    .svc.is-enhanced .svc-scope:last-child {
        border-bottom: 0;
    }

    .svc.is-enhanced .svc-scope:hover {
        color: var(--ink-soft);
    }

    /* The selected scope takes the panel's white and carries a solid olive
       edge, so which one is live never depends on a shade of grey alone. */
    .svc.is-enhanced .svc-scope.is-active {
        background-color: var(--card);
        color: var(--color-text);
    }

    .svc.is-enhanced .svc-scope-icon {
        display: flex;
        flex-shrink: 0;
        color: var(--muted-2);
        transition: color 0.3s var(--ease-smooth);
    }

    .svc.is-enhanced .svc-scope:hover .svc-scope-icon {
        color: var(--ink-soft);
    }

    .svc.is-enhanced .svc-scope.is-active .svc-scope-icon {
        color: var(--accent-deep);
    }

    .svc.is-enhanced .svc-scope:focus-visible {
        outline: 2px solid var(--accent-deep);
        outline-offset: -2px;
    }

    /* One element, two jobs: it marks the live scope and, by filling top to
       bottom over the cycle, it is also the clock that advances the panel.
       Pausing this animation in CSS therefore pauses the cycle. */
    .svc.is-enhanced .svc-scope-timer {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background-color: var(--accent-deep);
        transform: scaleY(0);
        transform-origin: top;
    }

    .svc.is-enhanced:not(.is-running) .svc-scope.is-active .svc-scope-timer {
        transform: scaleY(1);
    }

    .svc.is-enhanced.is-running .svc-scope.is-active .svc-scope-timer {
        animation: svc-timer var(--svc-cycle, 7.5s) linear forwards;
    }

    .svc.is-enhanced:hover .svc-scope-timer,
    .svc.is-enhanced:focus-within .svc-scope-timer {
        animation-play-state: paused;
    }

    @keyframes svc-timer {
        from { transform: scaleY(0); }
        to { transform: scaleY(1); }
    }

    .svc.is-enhanced .svc-panels {
        display: grid;
        background-color: var(--card);
        padding: 44px 48px;
    }

    .svc.is-enhanced .svc-panel {
        grid-area: 1 / 1;
        display: flex;
        flex-direction: column;
        border-bottom: 0;
        padding: 0;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition:
            opacity 0.45s var(--ease-smooth),
            transform 0.45s var(--ease-smooth),
            visibility 0.45s;
    }

    .svc.is-enhanced .svc-panel.is-active {
        opacity: 1;
        visibility: visible;
        transform: none;
    }



}

@media (prefers-reduced-motion: reduce) {
    .svc.is-enhanced.is-running .svc-scope.is-active .svc-scope-timer {
        animation: none;
        transform: scaleY(1);
    }

    .svc.is-enhanced .svc-panel {
        transition: none;
    }
}

.sectors-cta {
    text-align: center;
    margin-top: 48px;
}

/* Our Process Section */
/* Page rhythm: paper -> paper-2 -> paper -> paper-2 -> paper -> lime -> ink.
   Tones alternate on every boundary, so no two neighbours share a background
   and the 1px hairlines that used to stand in for an edge are gone. The body
   stays in one tonal family; inversion is saved for the closing CTA and
   footer, so going dark keeps meaning "you've reached the end". */
.our-process-section {
    padding: 120px var(--pad-x);
    background-color: var(--color-surface);
}

/* Header and rail share one centred measure, so the section reads as a
   single column with balanced margins instead of content pinned left with
   a void on the right. Text inside stays left-aligned, matching the rest
   of the page. */
.process-header {
    margin: 0 auto 88px;
    max-width: 900px;
    text-align: center;
}


.process-header h2 {
    font-family: var(--font-heading);
    font-size: 76px;
    letter-spacing: -0.76px;
    color: var(--color-text);
    margin-bottom: 20px;
    line-height: 1;
}

.process-header p {
    font-size: 20px;
    color: var(--ink-soft);
    max-width: 560px;
    margin: 0 auto;
}

/* The three steps read as one continuous timeline instead of three cards.
   Card chrome (panel, shadow, icon circle, number badge) is gone: the rail
   carries the sequence, and each step's substance sits in output chips
   rather than prose bullets, which cuts the section's word count roughly
   in half while keeping the same information.

   Each step owns its own rail segment, so the segments concatenate into a
   single line and each one fills when that step gets .in-view from the
   shared reveal observer. No JS beyond what the page already runs. */
.process-rail {
    list-style: none;
    margin: 0 auto;
    max-width: 900px;
    /* The steps sit left inside their block (the copy caps at 680px), so
       centring the block still reads as left-of-centre. This nudges the
       content, rail line included, back toward the optical centre without
       widening the block: box-sizing is border-box. */
    padding: 0 0 0 72px;
}

.rail-step {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    column-gap: 36px;
}

.rail-track {
    position: relative;
    display: flex;
    justify-content: center;
}

.rail-track::before,
.rail-track::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
}

.rail-track::before {
    background-color: var(--border-strong);
}

/* Fully drawn is the resting state, so the rail still reads if the scroll
   handler never runs (no JS) or is deliberately skipped (reduced motion).
   .is-scrubbed hands the fill over to the scroll position instead. */
.rail-track::after {
    background-color: var(--accent-deep);
    transform-origin: top;
}

.process-rail.is-scrubbed .rail-track::after {
    transform: scaleY(var(--rail-progress, 0));
    will-change: transform;
}

/* The last segment dissolves rather than stopping dead, so the timeline
   reads as ongoing work instead of a hard finish line. */
.rail-step:last-child .rail-track::before,
.rail-step:last-child .rail-track::after {
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
}

.rail-node {
    position: relative;
    z-index: 1;
    margin-top: 13px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background-color: var(--accent);
    border: 1px solid var(--accent-deep);
    box-shadow: 0 0 0 5px rgba(211, 233, 122, 0.45);
    transition:
        background-color 0.3s var(--ease-smooth),
        border-color 0.3s var(--ease-smooth),
        box-shadow 0.3s var(--ease-smooth);
}

/* Under scroll control a step starts unreached and lights as the fill
   arrives, so scrolling back up dims it again. */
.process-rail.is-scrubbed .rail-node {
    background-color: var(--color-surface);
    border-color: var(--border-strong);
    box-shadow: 0 0 0 5px rgba(211, 233, 122, 0);
}

.process-rail.is-scrubbed .rail-step.is-reached .rail-node {
    background-color: var(--accent);
    border-color: var(--accent-deep);
    box-shadow: 0 0 0 5px rgba(211, 233, 122, 0.45);
}

/* One stacked column, not two: splitting the step across columns left the
   copy unable to fill its half and opened a void beside it. The generous
   bottom padding is deliberate — it is the scroll distance that makes
   arriving at the next step feel like a step. */
.rail-body {
    padding-bottom: 200px;
    opacity: 1;
}

/* Steps ahead of the reader sit dimmed and come up to full strength as the
   scroll position reaches them, which previews what is coming without
   competing with the step being read. */
.process-rail.is-scrubbed .rail-body {
    opacity: var(--step-focus, 1);
}

.rail-heading {
    margin-bottom: 24px;
}

.rail-step:last-child .rail-body {
    padding-bottom: 0;
}

.rail-index {
    display: block;
    font-family: var(--font-heading);
    font-size: 72px;
    line-height: 0.8;
    color: var(--accent-deep);
    margin-bottom: 10px;
    transition: color 0.35s var(--ease-smooth);
}

/* The number carries the "you are here" state: ghosted until the rail
   reaches the step, solid once it does. */
.process-rail.is-scrubbed .rail-index {
    color: rgba(79, 94, 29, 0.26);
}

.process-rail.is-scrubbed .rail-step.is-reached .rail-index {
    color: var(--accent-deep);
}

.rail-heading h3 {
    font-family: var(--font-heading);
    font-size: 46px;
    letter-spacing: -0.46px;
    line-height: 1.05;
    color: var(--color-text);
    margin: 0;
}

/* --muted on the paper-2 field lands at ~3.9:1, under the 4.5:1 floor for
   body text. --ink-soft clears it comfortably and still reads softer than
   the headings. */
.rail-copy {
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 30px;
    max-width: 680px;
}

.rail-outputs-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: 12px;
}

.rail-outputs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

/* The deliverables are the section's payload, so they sit on white to lift
   off the paper-2 field instead of dissolving into it. */
.rail-outputs li {
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
    background-color: var(--card);
    padding: 12px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.05);
}

@media (max-width: 1024px) {
    .process-rail {
        padding-left: 0;
    }

    .rail-body {
        padding-bottom: 140px;
    }

    .rail-index {
        font-size: 60px;
    }

    .rail-heading h3 {
        font-size: 36px;
    }

    .rail-copy {
        font-size: 18px;
    }
}

