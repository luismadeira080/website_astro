.mockup-dots {
    display: flex;
    gap: 6px;
}

.mockup-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #444;
}

.mockup-dots span:nth-child(1) {
    background-color: #ff5f56;
}

.mockup-dots span:nth-child(2) {
    background-color: #ffbd2e;
}

.mockup-dots span:nth-child(3) {
    background-color: #27c93f;
}

.mockup-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
}

.mockup-content {
    padding: 24px;
}

.chat-message {
    margin-bottom: 20px;
    padding: 16px;
    border-radius: 12px;
    line-height: 1.6;
}

.chat-message.user {
    background-color: rgba(211, 233, 122, 0.1);
    border: 1px solid rgba(211, 233, 122, 0.3);
}

.chat-message.user p {
    color: var(--color-text);
    font-size: 15px;
    margin: 0;
}

.chat-message.assistant {
    background-color: #222;
    border: 1px solid #333;
    position: relative;
}

.chat-message.assistant p {
    color: var(--color-text);
    font-size: 15px;
    margin: 0;
}

.rank-badge {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--on-accent);
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 8px;
}

.testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
}

.testimonial-card:hover {
    border-color: var(--color-accent);
}

.testimonial-tag {
    display: inline-block;
    background-color: rgba(211, 233, 122, 0.1);
    color: var(--color-accent);
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    align-self: flex-start;
}

.testimonial-text {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text);
    opacity: 0.9;
    font-style: italic;
}

.testimonial-author {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid #333;
}

.author-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 4px;
}

.author-title {
    font-size: 13px;
    color: var(--color-text);
    opacity: 0.6;
}

/* Featured Projects - keeping for projects page */
.featured-projects {
    padding: 80px var(--pad-x);
    border-top: 1px solid #333;
}

.section-header {
    margin-bottom: 80px;
}

.section-header h2 {
    font-family: var(--font-heading);
    font-size: 76px;
    letter-spacing: -0.76px;
    color: var(--color-text);
    margin-bottom: 24px;
    line-height: 1;
}

.section-header p {
    font-size: 18px;
    max-width: 600px;
}

.projects-grid {
    display: flex;
    flex-direction: column;
    gap: 120px;
}

.project {
    display: grid;
    grid-template-columns: 600px 1fr;
    gap: 48px;
    align-items: center;
}

.project-reverse {
    direction: rtl;
}

.project-reverse > * {
    direction: ltr;
}

.project-image {
    position: relative;
    width: 600px;
    height: 600px;
    background-color: var(--color-dark);
    border-radius: 16px;
    overflow: hidden;
}

.project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.project-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: rgba(0, 0, 0, 0.7);
    color: var(--color-text);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
}

.project-content {
    padding: 60px 0;
}

.project-content a {
    text-decoration: none;
    color: inherit;
}

.project-content h3 {
    font-size: 45px;
    line-height: 1.2;
    margin-bottom: 24px;
    color: var(--color-text);
    transition: color 0.3s ease;
}

.project-content a:hover h3 {
    color: var(--color-accent);
}

.project-image {
    display: block;
    text-decoration: none;
}

.project-content > p {
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 32px;
    color: var(--color-text);
}

.project-info {
    margin-bottom: 32px;
}

.project-info h4 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--color-text);
}

.info-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.info-item {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid #333;
}

.info-label {
    font-size: 16px;
    color: var(--color-text);
}

.info-value {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text);
}

.project-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
}

.project-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 4px;
    transition: color 0.3s ease;
}

.project-link:hover {
    color: var(--color-accent);
}

.project-link svg {
    width: 20px;
    height: 20px;
}

/* About Section */
.about-section {
    padding: 120px var(--pad-x);
    background-color: var(--color-bg);
}

.about-section h2 {
    font-family: var(--font-heading);
    font-size: 91px;
    letter-spacing: -0.91px;
    margin-bottom: 40px;
}

.about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
}

.about-intro h3 {
    font-size: 45px;
    line-height: 1.2;
    color: var(--color-text);
}

.about-description p {
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 24px;
}

.text-link {
    display: inline-block;
    color: var(--accent-deep);
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    border-bottom: 2px solid var(--accent-deep);
    padding-bottom: 4px;
    transition: color 0.3s ease, border-color 0.3s ease;
}

.text-link:hover {
    color: var(--accent-deep-hover);
    border-bottom-color: var(--accent-deep-hover);
}

/* Contact Section */
.contact-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding: 80px var(--pad-x);
    border-top: 1px solid #333;
}

.contact-left h2 {
    font-family: var(--font-heading);
    font-size: 76px;
    letter-spacing: -0.76px;
    margin-bottom: 32px;
}

.contact-details {
    margin-bottom: 32px;
}

.contact-details p {
    font-size: 18px;
    line-height: 1.5;
    margin-bottom: 8px;
}

.contact-details a {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    transition: color 0.3s ease;
}

.contact-details a:hover {
    color: var(--color-accent);
}

.social-links {
    display: flex;
    gap: 24px;
    margin-bottom: 120px;
}

.social-links a {
    color: var(--color-text);
    transition: color 0.3s ease;
}

.social-links a:hover {
    color: var(--color-accent);
}

.copyright {
    font-size: 16px;
    color: var(--color-text);
    opacity: 0.6;
}

/* Simple Contact Section */
.contact-section-simple {
    padding: 0;
    margin: 80px var(--pad-x);
    position: relative;
    overflow: hidden;
}

.contact-container {
    background: var(--accent);
    border: none;
    border-radius: 32px;
    padding: 120px 80px;
    position: relative;
    overflow: hidden;
}

.cta-content {
    position: relative;
    z-index: 2;
    max-width: 700px;
}

.contact-section-simple h2 {
    font-family: var(--font-heading);
    font-size: 72px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -1.5px;
    margin-bottom: 32px;
    color: var(--ink);
}

.cta-subtext {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 48px;
    color: #2a2a24;
    max-width: 600px;
}

.cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--ink);
    color: var(--paper);
    padding: 18px 48px;
    border-radius: 27px;
    border: none;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
    font-family: var(--font-primary);
    text-decoration: none;
}

.cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(26, 26, 26, 0.25);
    background-color: #000;
}

.cta-background-text {
    position: absolute;
    right: 80px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 400px;
    font-weight: 400;
    color: rgba(26, 26, 26, 0.06);
    line-height: 1;
    font-family: var(--font-heading);
    pointer-events: none;
    z-index: 1;
}

.contact-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-accent);
    font-weight: 600;
}

.contact-value {
    font-size: 18px;
    color: var(--color-text);
    font-weight: 500;
}

/* Contact Form */
.contact-form {
    padding-top: 0;
}

.form-group {
    margin-bottom: 24px;
}

.form-group label {
    display: block;
    font-size: 16px;
    margin-bottom: 12px;
    color: var(--color-text);
}

.form-group input,
.form-group textarea {
    width: 100%;
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #333;
    padding: 16px;
    font-size: 16px;
    color: var(--color-text);
    font-family: var(--font-primary);
    transition: border-color 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-bottom-color: var(--color-accent);
}

.form-group textarea {
    resize: vertical;
}

.btn-submit {
    background-color: var(--color-accent);
    color: var(--on-accent);
    padding: 16px 48px;
    border: none;
    border-radius: 27px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: transform 0.3s ease, background-color 0.3s ease;
}

.btn-submit:hover {
    background-color: #c5db6f;
    transform: translateY(-2px);
}

.btn-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
}

/* Form Success Message */
.form-success {
    text-align: center;
    padding: 60px 40px;
    background-color: var(--color-dark);
    border: 1px solid var(--color-accent);
    border-radius: 16px;
    animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.success-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    background-color: var(--color-accent);
    color: var(--on-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    font-weight: bold;
    animation: scaleIn 0.5s ease 0.2s both;
}

@keyframes scaleIn {
    from {
        transform: scale(0);
    }
    to {
        transform: scale(1);
    }
}

.form-success h3 {
    font-family: var(--font-heading);
    font-size: 36px;
    color: var(--color-accent);
    margin-bottom: 12px;
    letter-spacing: -0.36px;
}

.form-success p {
    font-size: 16px;
    color: var(--color-text);
    opacity: 0.9;
}

